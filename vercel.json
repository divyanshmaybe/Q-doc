{
  "buildCommand": "sh -c 'if [ -d apps/web ]; then cd apps/web && npm install && npm run build; else npm run build; fi'",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://translations-significance-summer-magnitude.trycloudflare.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
